# ============================================================
# Sahovat — Production Environment Variables
# ============================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.

# ── General ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────
# These are used by docker-compose.prod.yml to create the DB.
# DATABASE_URL is built automatically inside docker-compose.
POSTGRES_USER=sahovat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=sahovat

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# ── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── SMS Provider (Eskiz.uz) ──────────────────────────────────
# Leave empty to use mock SMS (logs to console) for sandbox
SMS_API_URL=https://notify.eskiz.uz
SMS_API_EMAIL=
SMS_API_PASSWORD=
# Free / unverified Eskiz accounts can only send the literal pre-approved
# test message ("This is test from Eskiz"). Keep 'true' until template
# moderation is approved (PINFL / business registration required).
# OTP codes are still generated; read them from `docker logs sahovat_backend`.
SMS_ESKIZ_TEST_MODE=true

# ── Payment Provider (PayMe) ─────────────────────────────────
# Leave PAYME_MERCHANT_ID empty to use mock mode
# Get credentials from merchant.paycom.uz (requires company registration)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_SANDBOX=true
# Subscribe API URL (sandbox: https://checkout.test.paycom.uz/api, prod: https://checkout.paycom.uz/api)
PAYME_SUBSCRIBE_URL=https://checkout.test.paycom.uz/api

# ── Payment Provider (Click) ──────────────────────────────────
# Switch to 'real' once Click merchant account is activated.
# Requires CLICK_SECRET_KEY, CLICK_SERVICE_ID, CLICK_MERCHANT_ID when real.
PAYMENT_PROVIDER_CLICK=mock
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ── Storage ──────────────────────────────────────────────────
PUBLIC_STORAGE_PATH=./storage/public
PRIVATE_STORAGE_PATH=./storage/private
# In production, this should be your domain:
PUBLIC_STORAGE_URL=https://sahovat.tech/storage

# ── Frontend ─────────────────────────────────────────────────
# Must match your actual domain
FRONTEND_URL=https://sahovat.tech
NEXT_PUBLIC_API_URL=https://sahovat.tech/api

# ── OTP Settings ─────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900

# ── OneID (disabled for MVP) ─────────────────────────────────
ONEID_ENABLED=false

# ── Telegram Login Widget + Bot ──────────────────────────────
# Issued by @BotFather. Required in production to enable Telegram auth
# and bot notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SahovatTechBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=SahovatTechBot

# Production should use 'real' so notifications actually deliver.
TELEGRAM_PROVIDER=real
TELEGRAM_API_BASE=https://api.telegram.org
# Set to the admin Telegram group/channel chat id to receive admin alerts.
TELEGRAM_ADMIN_CHAT_ID=
# Shared secret expected on incoming /api/telegram/webhook requests
# (X-Telegram-Bot-Api-Secret-Token header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────
# Production must use 'resend' with a non-empty API key. Mock provider
# is rejected by zod refine() when NODE_ENV=production.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@sahovat.tech
EMAIL_FROM_NAME=Sahovat
EMAIL_REPLY_TO=support@sahovat.tech
APP_BASE_URL=https://sahovat.tech

# ── Notification Dispatcher ──────────────────────────────────
NOTIFICATION_QUEUE_TICK_MS=10000
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
