# ============================================================
# Sahovat — Production Environment Variables
# ============================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.

# ── General ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────
# These are used by docker-compose.prod.yml to create the DB.
# DATABASE_URL is built automatically inside docker-compose.
POSTGRES_USER=sahovat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=sahovat

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

# ── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── SMS Provider (Eskiz.uz) ──────────────────────────────────
SMS_API_URL=https://notify.eskiz.uz
# Required — your Eskiz account email and password
SMS_API_EMAIL=
SMS_API_PASSWORD=
# Free / unverified Eskiz accounts can only send the literal pre-approved
# test message ("This is test from Eskiz"). Keep 'true' until template
# moderation is approved (PINFL / business registration required).
# OTP codes are still generated; read them from `docker logs sahovat_backend`.
SMS_ESKIZ_TEST_MODE=true

# ── Payment Provider (PayMe) ─────────────────────────────────
# Leave PAYME_MERCHANT_ID empty to use mock mode
# Get credentials from merchant.paycom.uz (requires company registration)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_SANDBOX=true
# Subscribe API URL (sandbox: https://checkout.test.paycom.uz/api, prod: https://checkout.paycom.uz/api)
PAYME_SUBSCRIBE_URL=https://checkout.test.paycom.uz/api

# ── Storage ──────────────────────────────────────────────────
PUBLIC_STORAGE_PATH=./storage/public
PRIVATE_STORAGE_PATH=./storage/private
# In production, this should be your domain:
PUBLIC_STORAGE_URL=https://sahovat.tech/storage

# ── Frontend ─────────────────────────────────────────────────
# Must match your actual domain
FRONTEND_URL=https://sahovat.tech
NEXT_PUBLIC_API_URL=https://sahovat.tech/api

# ── OTP Settings ─────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900

# ── OneID (disabled for MVP) ─────────────────────────────────
ONEID_ENABLED=false
