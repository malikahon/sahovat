# Server Configuration
PORT=3001
NODE_ENV=development

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahovat
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_LENGTH=6

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_FILES=15

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=1
KYC_THRESHOLD=3000000

# CORS
CORS_ORIGIN=http://localhost:3000

# SMS Provider (mock for development)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=

# Payment Providers (mock for development)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
