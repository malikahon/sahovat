# ============================================================
# Sahovat — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://sahovat:sahovat@localhost:5433/sahovat

# ── Cache/Sessions (Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────
# JWT secrets (min 32 characters each)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string-32-chars

# Encryption key for sensitive data (AES-256-GCM)
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── SMS Provider (Eskiz.uz) ──────────────────────────────────
SMS_API_URL=https://notify.eskiz.uz
SMS_API_EMAIL=
SMS_API_PASSWORD=
# Free / unverified Eskiz accounts can only send the literal pre-approved
# test message ("This is test from Eskiz"). Set to 'true' until you have
# template moderation approval (requires PINFL / business registration).
# OTP codes are still generated; read them from `docker logs sahovat_backend`.
SMS_ESKIZ_TEST_MODE=false

# ── Payment Provider (PayMe) ─────────────────────────────────
# Leave PAYME_MERCHANT_ID empty to use mock mode (card tokenization simulated locally)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_SANDBOX=true
# Subscribe API URL (sandbox: https://checkout.test.paycom.uz/api)
PAYME_SUBSCRIBE_URL=https://checkout.test.paycom.uz/api

# ── Payment Provider (Click) ──────────────────────────────────
# PAYMENT_PROVIDER_CLICK=mock for demo; switch to 'real' when merchant
# account is activated. Zero code changes required — env swap only.
PAYMENT_PROVIDER_CLICK=mock
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Checkout URL (production: https://my.click.uz/services/pay)
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ── Storage ──────────────────────────────────────────────────
# Local file storage paths
PUBLIC_STORAGE_PATH=./storage/public
PRIVATE_STORAGE_PATH=./storage/private
# URL prefix for serving public files
PUBLIC_STORAGE_URL=http://localhost:3001/storage

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── OTP Settings ─────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900

# ── Telegram Login Widget + Bot ──────────────────────────────
# Token issued by @BotFather. Required for HMAC verification of Login
# Widget payloads and bot notifications. Leave empty to disable Telegram
# auth. The username (without @) must match the bot the token belongs to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SahovatTechBot
# Public-facing — read by the frontend Telegram widget.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=SahovatTechBot

# Bot push notifications. 'mock' logs sends only; 'real' calls api.telegram.org.
TELEGRAM_PROVIDER=mock
TELEGRAM_API_BASE=https://api.telegram.org
# Optional: numeric chat id of the admin Telegram group/channel to receive
# admin alerts (new campaign pending, new withdrawal request, contact form).
TELEGRAM_ADMIN_CHAT_ID=
# Shared secret expected on incoming /api/telegram/webhook requests
# (X-Telegram-Bot-Api-Secret-Token). Set this in @BotFather setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────
# EMAIL_PROVIDER=mock during dev avoids burning the Resend free-tier quota.
# Switch to 'resend' once Week 0 DNS records (SPF/DKIM/DMARC) are verified.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@sahovat.tech
EMAIL_FROM_NAME=Sahovat
EMAIL_REPLY_TO=support@sahovat.tech
APP_BASE_URL=http://localhost:3000

# ── Notification Dispatcher ──────────────────────────────────
# How often the retry-queue tick runs (ms). Each tick pops due jobs
# from the Redis ZSET and dispatches them.
NOTIFICATION_QUEUE_TICK_MS=10000
# Total attempts before a notification is dropped + admin-logged.
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
